{
  "name": "platform",
  "version": "1.0.0",
  "description": "开源大梳理的新一代检索与编辑平台",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "wrangler dev",
    "seed:local": "tsx scripts/seed-local.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "backup:export": "tsx scripts/export-backup.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.12.33",
    "markdown-it": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
